# Credenciales de la app de Meta (developers.facebook.com > tu app > Configuración básica)
META_APP_ID=
META_APP_SECRET=

# Debe coincidir EXACTAMENTE con un "URI de redireccionamiento de OAuth válido"
# configurado en Facebook Login > Configuración, dentro de tu app de Meta.
META_REDIRECT_URI=http://localhost:4000/api/auth/facebook/callback

# URL del frontend a la que se vuelve a redirigir tras conectar/cancelar la cuenta.
FRONTEND_URL=http://localhost:5173

PORT=4000
